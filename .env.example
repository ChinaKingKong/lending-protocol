# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Etherscan API Key（仅在 Sepolia/主网验证合约时需要，见 https://etherscan.io/myapikey）
# ETHERSCAN_API_KEY=your_etherscan_api_key

# Sepolia RPC URL (optional, default: https://rpc.sepolia.org)
# 建议使用 Alchemy/Infura 等获取专属 URL 以提升稳定性与速率
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Hardhat 本地区块浏览器 base URL（仅前端，chainId=31337 时使用）
# 未设置时本地网络交易哈希仅展示不跳转；若自建本地区块浏览器再配置此项
# 示例：VITE_HARDHAT_EXPLORER_URL=http://127.0.0.1:3001
